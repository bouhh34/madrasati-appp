NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
APP_ORIGIN=https://YOUR-DOMAIN.example
PASSWORD_PEPPER=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
AUDIT_HMAC_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
BOOTSTRAP_SECRET=GENERATE_A_THIRD_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=45
TRUST_PROXY=true
MAX_BRANDING_BYTES=5242880
